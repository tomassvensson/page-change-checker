{
  "name": "page-change-checker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js run",
    "dev": "tsx src/cli/index.ts",
    "scrape": "tsx src/cli/index.ts run",
    "schedule": "tsx src/cli/index.ts schedule",
    "seed": "tsx src/cli/index.ts seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:static": "npm run lint && npm run format:check && npm run build",
    "verify": "npm run verify:static && npm run test:coverage && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "cron-parser": "^4.9.0",
    "diff": "^7.0.0",
    "nodemailer": "^8.0.7",
    "playwright": "^1.51.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.0",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.22.0",
    "eslint-plugin-import-x": "^4.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
