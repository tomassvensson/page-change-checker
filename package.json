{
  "name": "page-change-checker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli/index.js run",
    "monitor": "node dist/src/monitor/local.js",
    "dev": "tsx src/cli/index.ts",
    "scrape": "tsx src/cli/index.ts run",
    "schedule": "tsx src/cli/index.ts schedule",
    "seed": "tsx src/cli/index.ts seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "publication:check": "tsx src/tooling/check-publication.ts",
    "check:ci": "tsx src/tooling/ciChecks.ts",
    "check:docker": "tsx src/tooling/dockerCheck.ts",
    "check:sonar-auth": "tsx src/tooling/sonarAuth.ts",
    "prepush": "tsx src/tooling/prepush.ts",
    "verify:static": "npm run publication:check && npm run check:ci && npm run lint && npm run format:check && npm run build",
    "verify": "npm run audit:prod && npm run verify:static && npm run test:coverage && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "ipaddr.js": "^2.4.0",
    "nodemailer": "^10.6.0",
    "playwright": "^1.51.1",
    "safe-regex2": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.0",
    "eslint-plugin-import-x": "^4.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^4.1.10",
    "yaml": "2.9.1"
  }
}
