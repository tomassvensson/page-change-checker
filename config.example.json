{
  "databasePath": "data/page-change-checker.sqlite",
  "network": {
    "allowPrivateAddresses": false,
    "allowedHosts": []
  },
  "normalize": {
    "trimWhitespace": true,
    "collapseWhitespace": true,
    "caseInsensitive": false
  },
  "retry": {
    "maxAttempts": 3,
    "baseDelayMs": 1000,
    "backoffFactor": 2,
    "maxDelayMs": 30000
  },
  "concurrency": {
    "global": 3,
    "perHost": 1
  },
  "rateLimit": {
    "minDelayMs": 500,
    "maxDelayMs": 2000
  },
  "browser": {
    "headless": true,
    "userDataDir": "data/user-data",
    "timeoutMs": 30000,
    "maxContentLength": 2000000,
    "waitUntil": "domcontentloaded",
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36",
    "locale": "de-DE",
    "timezoneId": "Europe/Berlin",
    "extraHTTPHeaders": {
      "Accept-Language": "de-DE,de;q=0.9,en-US;q=0.8,en;q=0.7"
    },
    "viewport": {
      "width": 1280,
      "height": 900
    },
    "cookieConsent": {
      "enabled": false,
      "timeoutMs": 3000,
      "buttonTextRegex": "^(Alle akzeptieren|Akzeptieren|Zustimmen|Einverstanden|Accept all|Accept|I agree|Agree)$",
      "cssSelectors": ["#onetrust-accept-btn-handler"]
    }
  },
  "schedule": {
    "intervalHours": 24
  },
  "login": {
    "interactive": false,
    "waitTimeoutMs": 600000
  },
  "screenshot": {
    "onChange": true,
    "dir": "screenshots",
    "mode": "page",
    "maxAgeDays": 30,
    "maxCount": 100
  },
  "notifications": {
    "onlyChanges": true,
    "contentMode": "summary",
    "maxContentLength": 500,
    "maxPayloadLength": 1000000,
    "timeoutMs": 10000,
    "failOnError": false,
    "webhooks": []
  },
  "urls": [
    {
      "url": "https://www.kleinanzeigen.de/pro/salzmann",
      "enabled": true,
      "tags": ["listings", "real-estate"],
      "overrides": {
        "viewport": { "width": 1440, "height": 1080 }
      },
      "selectors": [
        {
          "cssPath": "div.my-large div.list-none a.items-center",
          "elementIndex": 0,
          "compareMode": "innerText",
          "name": "Listing count",
          "enabled": true,
          "ignorePatterns": ["\\d+ Anzeigen heute"],
          "waitForSelector": "div.my-large",
          "waitForSelectorTimeoutMs": 10000,
          "normalizeOverride": {
            "trimWhitespace": true,
            "collapseWhitespace": true,
            "caseInsensitive": true
          }
        }
      ],
      "loginChecks": []
    }
  ]
}
